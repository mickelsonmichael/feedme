{
  "expo": {
    "name": "feedme",
    "slug": "feedme",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#3d358f"
      },
      "package": "com.feedme.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "baseUrl": "/feedme"
    },
    "plugins": [
      "expo-web-browser",
      "expo-image",
      "expo-screen-orientation",
      "expo-background-task",
      "expo-sharing",
      "expo-sqlite",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#faf8f3",
          "dark": {
            "image": "./assets/splash-icon.png",
            "backgroundColor": "#0f1012"
          }
        }
      ],
      "@react-native-vector-icons/feather",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# WorkManager 2.9 (and the Room 2.5 it pulls in) keep these classes but not\n# the constructors it calls by reflection, so R8 strips them. Without the\n# database one the app crashes on launch; without the merger one every\n# background sync fails.\n-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class * extends androidx.work.InputMerger { <init>(); }"
          }
        }
      ]
    ]
  }
}
