{
  "name": "feedme",
  "version": "1.0.0",
  "main": "index.ts",
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-sqlite"
        ]
      }
    }
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "e2e": "maestro test e2e/maestro",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/node_modules/react-native-gesture-handler/jestSetup.js",
      "<rootDir>/jest.setup.js"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|@shopify/flash-list))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setupAfterEnv.js"
    ],
    "resolver": "<rootDir>/jest.resolver.js"
  },
  "dependencies": {
    "@react-native-vector-icons/feather": "^14.0.0",
    "@react-navigation/bottom-tabs": "^7.21.0",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@shopify/flash-list": "2.3.2",
    "expo": "~58.0.21",
    "expo-background-task": "~58.0.11",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-image": "~58.0.18",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.7",
    "expo-screen-orientation": "~58.0.3",
    "expo-sharing": "~58.0.21",
    "expo-splash-screen": "~58.0.12",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "expo-task-manager": "~58.0.12",
    "expo-web-browser": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-render-html": "^6.3.4",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "private": true,
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "prettier": "^3.9.10",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  }
}
